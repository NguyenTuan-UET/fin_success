# Biến môi trường cho Railway (đặt ở tab Variables của dịch vụ backend). KHÔNG commit giá trị thật.
FCC_ENV=production
# Railway tự đặt PORT; HOST đã là 0.0.0.0 trong Dockerfile
TRUST_PROXY=1
# Tham chiếu tới dịch vụ Postgres của Railway: ${{Postgres.DATABASE_URL}} (mạng nội bộ, không cần DATABASE_SSL)
DATABASE_URL=
# chỉ đặt 1 nếu dùng địa chỉ Postgres công khai (có SSL)
# DATABASE_SSL=1
# 64 ký tự hex: openssl rand -hex 32. Cất riêng ngoài Railway; mất khóa là mất mọi tệp đã mã hóa
FCC_DATA_KEY=
# Ổ đĩa (Volume) gắn vào /data
FILES_DIR=/data/objects
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Địa chỉ giao diện trên Vercel, dùng trong liên kết email
APP_URL=https://ten-du-an.vercel.app
OLLAMA_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.congty.vn:465
# MAIL_FROM="FCC <no-reply@congty.vn>"
