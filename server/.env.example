PORT=8787
# dev (mặc định): không đăng nhập, mỗi vai trò có trang riêng tự vào phiên, chỉ chạy trên localhost.
# staging | production: bắt buộc đăng nhập; tài khoản nhân sự FCC tạo từ ADMIN_EMAIL/ADMIN_PASSWORD (≥ 12 ký tự).
FCC_ENV=dev
# DB_PATH=./data/fcc.db
ADMIN_EMAIL=
ADMIN_PASSWORD=
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com
# Khóa dữ liệu 64 ký tự hex (mã hóa tệp chứng từ và secret MFA). dev tự tạo ở data/data.key; staging/production bắt buộc.
# FCC_DATA_KEY=
# Địa chỉ giao diện dùng trong liên kết email (mời thành viên, đặt lại mật khẩu)
# APP_URL=http://localhost:3000
# Nhà cung cấp chữ ký số từ xa / eKYC (cần adapter tương ứng trong src/integrations). Bỏ trống: dùng MFA + băm nội dung / FCC đối chiếu giấy tờ.
# SIGNING_PROVIDER=
# EKYC_PROVIDER=
# Gửi email (mời thành viên, đặt lại mật khẩu, thông báo). Bỏ trống: chỉ ghi log. Ví dụ: smtps://user:pass@smtp.congty.vn:465
# SMTP_URL=
# MAIL_FROM="FCC <no-reply@congty.vn>"
